# OpenAI / LLM Configuration
OPENAI_API_KEY=sk-your-api-key-here
# 如果使用第三方/兼容 API (如 DeepSeek, 代理转发等)，请取消注释并填写
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o

# Ghidra Configuration (Linux example: /opt/ghidra_11.X_PUBLIC, Windows example: C:/ghidra)
GHIDRA_HOME=/opt/ghidra

# Target Binary Configuration
BINARY_PATH=body.bin
BASE_ADDR=0x9FA00000
PROJECT_DIR=./ghidra_proj
PROJECT_NAME=abl_analysis
SCRIPT_DIR=./ghidra_scripts
